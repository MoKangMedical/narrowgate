# 窄门支付系统配置
# 复制此文件为 .env 并填入实际配置

# 微信支付配置
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_API_KEY=your_api_key
WECHAT_PAY_CERT_PATH=/path/to/cert.pem
WECHAT_PAY_KEY_PATH=/path/to/key.pem
WECHAT_PAY_APP_ID=your_app_id
WECHAT_PAY_NOTIFY_URL=https://narrowgatemind.top/api/payment/wechat/notify

# 支付宝配置
ALI_PAY_APP_ID=your_app_id
ALI_PAY_PRIVATE_KEY=your_private_key
ALI_PAY_PUBLIC_KEY=your_public_key
ALI_PAY_NOTIFY_URL=https://narrowgatemind.top/api/payment/alipay/notify

# 通用配置
PAYMENT_CURRENCY=CNY
PAYMENT_EXPIRE_MINUTES=30

# Qwen / DashScope 语音合成配置
# 不要把真实 API Key 提交到 GitHub；复制到本地 .env 或只在终端 export。
DASHSCOPE_API_KEY=your_dashscope_api_key
# 北京地域：https://dashscope.aliyuncs.com/api/v1
# 新加坡地域：https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TTS_MODEL=qwen3-tts-instruct-flash
QWEN_TTS_VOICE=Cherry
QWEN_TTS_LANGUAGE=Chinese
QWEN_TTS_INSTRUCTIONS=请用沉稳、温和、低速、有停顿的中文课程导师声音朗读。语气不要表演化，要像陪伴一个人安静地面对自己。

# 未来课程音频标准：DeepSeek 口播稿 + Edge Neural TTS + ffmpeg 统一响度
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
EDGE_TTS_VOICE=zh-CN-YunyangNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=-2Hz
NEURAL_AUDIO_BITRATE=48k
